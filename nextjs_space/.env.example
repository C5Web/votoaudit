# ==========================================================================
# VotoAudit — modelo de variáveis de ambiente
# Copie para .env e preencha com os seus valores. NÃO faça commit do .env real.
# ==========================================================================

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:senha@localhost:5432/votoaudit?schema=public"

# --- Autenticação (Auth.js / NextAuth) ---
# Gere um segredo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# --- Login com Google (opcional) ---
# O botão de login com Google só aparece quando estas credenciais são reais.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Armazenamento de documentos (S3 ou compatível) ---
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="seu-bucket"
AWS_FOLDER_PREFIX="votoaudit/"
# Use um profile local OU chaves de acesso (não as duas).
AWS_PROFILE=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# --- Administração ---
# E-mails que recebem o papel de administrador geral (separados por vírgula).
SUPER_ADMIN_EMAILS="admin@exemplo.com.br"

# --- Serviços opcionais (LLM / notificações) ---
ABACUSAI_API_KEY=""
WEB_APP_ID=""
NOTIF_ID_CONVITE_PARA_O_VOTOAUDIT=""
NOTIF_ID_ALERTAS_DE_AUDITORIA=""

# --- Web Push (notificações push / VAPID) ---
# Gere um par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@votoaudit.com.br"
